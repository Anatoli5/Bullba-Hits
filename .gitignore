# Public repository: current source and build files only.
# Everything else remains local, including agent context and game data.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/CHANGELOG.md
!/THIRD_PARTY.md
!/mod/
!/web/
!/licenses/
!/installer/
!/tools/
!/tests/

__pycache__/
*.pyc
*.log
.env
.env.*

/installer/*
!/installer/ArmorInspector.iss
!/installer/armor-inspector.ico
# The script form of the installer: the .cmd, the .ps1 and the README the builder stages.
!/installer/script/
!/installer/upgrades/
# Upgrade manifests are the recorded hashes of released builds, kept for reference; the installer does not read them.
/installer/upgrades/*
!/installer/upgrades/*.json

/tools/*
!/tools/build.py
!/tools/package.py
!/tools/build_installer.py
!/tools/build_script_installer.py
!/tools/fetch_installer_compiler.py
!/tools/make_installer_icon.ps1
!/tools/release_github.py
!/tools/verdicts_from_log.py
!/tools/verdicts_offline.cjs
!/tools/extract_crit_icons.py
!/tools/crits_from_records.py
!/tools/preview.py
!/tools/third_party.py
!/tools/shot_spread_from_records.py
!/tools/build_equipment_catalogue.py
!/tools/build_vehicle_modes.py
!/tools/check.py

# Tests are code and are tracked (24.09, audit QA-06). What is NOT: fixtures extracted from the client or from the
# player's records (tests/fixtures-local/: TTX files and references, the client's penetration figures, one-off stands
# under the game's python27.dll, retired tests). A check that needs them says SKIP where they are absent.
/tests/fixtures-local/
